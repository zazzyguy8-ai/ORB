# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- ContactOut -------------------------------------------------------------
# Requires a Team/API plan. The API is separate from the Chrome extension and
# works from any machine; you do not need a browser to use it.
CONTACTOUT_API_KEY=

# Only change these if ContactOut's docs disagree with the defaults (they have
# shipped more than one convention: `token` on v1, `x-api-key` on v2).
# CONTACTOUT_BASE_URL=https://api.contactout.com/v1
# CONTACTOUT_ENRICH_PATH=/linkedin/enrich
# CONTACTOUT_AUTH_HEADER=token

# --- Pattern fallback -------------------------------------------------------
# Set to false to skip MX lookups (faster, but lets dead domains through).
PATTERN_CHECK_MX=true
