# ---------------------------------------------------------------------------
# ORB Signal — environment
#
# Copy to .env.local and fill in. Nothing here is read from the browser except
# the two NEXT_PUBLIC_ values, which are safe by design (anon key + project URL).
#
# The app degrades honestly: with none of these set, analysis still runs on the
# keyless providers, the explanation falls back to deterministic text, and
# history/outcome tracking report themselves as disabled.
# ---------------------------------------------------------------------------

# --- AI (explanation phrasing only; the decision is computed server-side) ----
# Without this, explanations render deterministically from the evidence list.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5. Set claude-sonnet-5 or
# claude-haiku-4-5 to trade explanation quality for lower latency.
ANTHROPIC_MODEL=

# --- Database / auth (Supabase) ---------------------------------------------
# Without these: no history, no outcome tracking, no accounts. Analysis works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana RPC --------------------------------------------------------------
# The public endpoint works but is aggressively throttled; a dedicated RPC is
# strongly recommended, since holder concentration depends on it.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Optional providers ------------------------------------------------------
# Enables the large-wallet flow category. Without it that category reports
# unavailable and its weight is redistributed — no fake wallet data is shown.
HELIUS_API_KEY=
# Raises GoPlus rate limits. The security provider works without them.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# --- Outcome tracking cron ---------------------------------------------------
# Required for /api/cron/snapshots. The endpoint refuses to run when unset.
CRON_SECRET=

# --- Telegram alerts (delivery transport only) -------------------------------
TELEGRAM_BOT_TOKEN=

# --- Tuning ------------------------------------------------------------------
PROVIDER_TIMEOUT_MS=2500
AI_TIMEOUT_MS=5000
ANON_ANALYSES_PER_DAY=3
IP_REQUESTS_PER_MINUTE=10

# --- Plans / pricing (spec §22: never hardcoded in the app) ------------------
FREE_ANALYSES_PER_DAY=10
PRO_ANALYSES_PER_DAY=500
PRO_PRICE_CENTS=1900
