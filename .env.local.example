# ---------------------------------------------------------------------------
# Required — nothing generates without this.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Signing key for unlock tokens. Generate with: openssl rand -hex 32
# Changing it invalidates every outstanding unlock, so set it once and leave it.
ORB_UNLOCK_SECRET=

# ---------------------------------------------------------------------------
# Card payments (Stripe). Optional, but this is the rail that works everywhere.
# Use the test key (sk_test_...) until you have clicked through a real purchase.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# Your public URL, so Stripe returns buyers to the right place behind a proxy.
# e.g. https://cultscan.xyz  — no trailing slash.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# USDC on Solana. Optional. Both of the blocks below are required together:
# a transaction signature is public, so without the claim store anyone watching
# the address could redeem someone else's payment. The rail stays off until
# both are set.
# ---------------------------------------------------------------------------
SOLANA_RECEIVE_ADDRESS=
# The public endpoint is heavily rate-limited. Point this at Helius/QuickNode
# /Triton before you drive real traffic.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Upstash Redis over REST — burns each payment receipt exactly once.
# Free tier is enough; create a database and copy both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
